# ============================================================
# 问津 Wenjin · 配置示例
# 复制为 .env 后按需修改：  cp .env.example .env
# server.js 启动时会自动读取同目录的 .env（已存在的环境变量优先）。
# ============================================================

# ---- 基础 ----
# 监听端口
PORT=3000
# 监听地址：只给本机反向代理用就写 127.0.0.1；Docker 里保持 0.0.0.0
HOST=0.0.0.0
# 数据目录（db.json 存放位置，包含用户、会话和渠道 API Key，请妥善备份、不要提交到 Git）
DATA_DIR=./data
# 站点名称（只在第一次创建数据库时使用，之后在管理后台「设置」里改）
SITE_NAME=问津

# ---- 管理后台 ----
# 管理员密码（至少 8 位）。只在数据库里还没有管理员密码时生效。
# 强烈建议设置：不设置的话，第一个打开 /admin 的人可以设置管理员密码。
ADMIN_PASSWORD=

# ---- 反向代理 / 真实 IP（影响限流和登录保护）----
# 0 = 直接对外提供服务，用 TCP 来源地址
# 1 = 前面有一层反向代理（nginx、Caddy、Cloudflare Tunnel 等），取 X-Forwarded-For 最后一项
# cloudflare = 优先使用 CF-Connecting-IP（仅当服务只能经 Cloudflare 访问时才安全）
TRUST_PROXY=0

# ---- 联网搜索（SearXNG）----
# SearXNG 地址，需要开启 json 输出格式（见 searxng/settings.yml）。
# 只在第一次创建数据库时作为默认值，之后可在管理后台「设置 → 联网搜索」修改。
# docker-compose 里使用 http://searxng:8080
SEARXNG_URL=http://127.0.0.1:8890

# ---- 发信邮箱（注册 / 找回密码的邮箱验证码）----
# 同时填了 SMTP_USER 和 SMTP_PASS 时，优先使用这里的配置，管理后台里的发信设置变为只读。
# 不填则可以在管理后台「设置 → 邮箱验证」里配置。QQ 邮箱的 SMTP_PASS 是「授权码」，不是登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=问津

# ---- 仅用于本地开发测试，生产环境不要开启 ----
# 设为 1 时图形验证码接口会把答案一起返回，方便写自动化测试。
# CAPTCHA_TEST=0
